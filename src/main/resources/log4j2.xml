<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="INFO">
	<Appenders>
		<Console name="console-log" target="SYSTEM_OUT">
			<PatternLayout pattern="[%-5level] %d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %X{ID} %c{1} - %msg%n"/>
		</Console>
		<RollingFile name="apra-log" fileName="logs/apra.log" filePattern="apra-log-%d{yyyy-MM-dd}.log">
			<PatternLayout>
				<pattern>[%-5level] %d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %X{ID} %c{1} - %msg%n</pattern>
			</PatternLayout>
			<Policies>
				<TimeBasedTriggeringPolicy interval="1" modulate="true"/>
			</Policies>
		</RollingFile>
		<RollingFile name="error-log" fileName="logs/apra-error.log" filePattern="apra-error-%d{yyyy-MM-dd}.log">
			<PatternLayout>
				<pattern>[%-5level] %d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %X{ID} %c{1} - %msg%n</pattern>
			</PatternLayout>
			<Policies>
				<TimeBasedTriggeringPolicy interval="1" modulate="true"/>
			</Policies>
		</RollingFile>
		<!-- STIG V-220635: Structured audit log for security events -->
		<RollingFile name="audit-log" fileName="logs/apra-audit.log" filePattern="apra-audit-%d{yyyy-MM-dd}.log">
			<PatternLayout>
				<pattern>%msg%n</pattern>
			</PatternLayout>
			<Policies>
				<TimeBasedTriggeringPolicy interval="1" modulate="true"/>
			</Policies>
			<DefaultRolloverStrategy>
				<Delete basePath="logs" maxDepth="1">
					<IfFileName glob="apra-audit-*.log"/>
					<IfLastModified age="365d"/>
				</Delete>
			</DefaultRolloverStrategy>
		</RollingFile>
	</Appenders>
	<Loggers>
		<!-- STIG V-220635: Dedicated audit logger with 1-year retention -->
		<Logger name="gov.faa.ait.apra.audit" level="info" additivity="false">
			<AppenderRef ref="audit-log"/>
		</Logger>
		<Logger name="gov.faa.ait.apra" level="info" additivity="false">
			<AppenderRef ref="apra-log"/>
		</Logger>
		<Root level="info" additivity="true">
			<AppenderRef ref="error-log" level="warn"/>
			<AppenderRef ref="apra-log" level="info"/>
		</Root>
	</Loggers>
</Configuration>